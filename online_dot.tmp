
/* ══ ONLINE DOT — Indicador de presencia ══ */
.l69-online-dot {
  display: inline-block;
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: #6b7280;          /* gris = offline */
  border: 2px solid var(--chat-bg, #1a1a2e);
  position: absolute;
  bottom: 1px;
  right: 1px;
  transition: background .3s ease;
  flex-shrink: 0;
}
.l69-online-dot.is-online {
  background: #22c55e;           /* verde = online */
  box-shadow: 0 0 0 0 rgba(34,197,94,.6);
  animation: l69-pulse-online 1.6s infinite;
}
@keyframes l69-pulse-online {
  0%   { box-shadow: 0 0 0 0 rgba(34,197,94,.6); }
  70%  { box-shadow: 0 0 0 7px rgba(34,197,94,0); }
  100% { box-shadow: 0 0 0 0 rgba(34,197,94,0); }
}
/* El wrap del avatar necesita position:relative para el dot absoluto */
.l69-chat-row__avatar {
  position: relative !important;
}

