            /* ══ Panel derecho — poblar lista de usuarios ══ */
            const usersOnlineList  = document.getElementById('usersPanelOnlineList');
            const usersOfflineList = document.getElementById('usersPanelOfflineList');
            const usersPanelCount  = document.getElementById('usersPanelCount');
            window.__usersCache    = {};

            function renderUsersPanel() {
                if (!usersOnlineList || !usersPanelCount) return;
                usersOnlineList.innerHTML = '';
                let onlineCount = 0;
                window.__onlineUsers.forEach(function(uid) {
                    if (String(uid) === String(ME)) return;
                    onlineCount++;
                    const d = window.__usersCache[uid] || { name: uid.substring(0,8) + '...', avatar: null, partnerId: uid };
                    const li = document.createElement('li');
                    li.className = 'l69-users-panel__item';
                    li.dataset.uid = uid;
                    const avatarHtml = d.avatar
                        ? '<img class="l69-users-panel__avatar" src="/photos/serve/' + d.avatar + '" onerror="this.style.display=\'none\';this.nextElementSibling.style.display=\'flex\'">'
                        : '';
                    const initialsStyle = d.avatar ? ' style="display:none"' : '';
                    li.innerHTML = avatarHtml +
                        '<div class="l69-users-panel__initials"' + initialsStyle + '>' + (d.name||'?').charAt(0).toUpperCase() + '</div>' +
                        '<span class="l69-users-panel__name">' + escHtml(d.name) + '</span>' +
                        '<span class="l69-users-panel__dot l69-users-panel__dot--online"></span>';
                    li.addEventListener('click', function() { openChat(d.partnerId, d.name, d.avatar); });
                    usersOnlineList.appendChild(li);
                });
                if (onlineCount === 0) usersOnlineList.innerHTML = '<li class="l69-users-panel__empty">Nadie conectado aún</li>';
                usersPanelCount.textContent = onlineCount;
                if (usersOfflineList) {
                    usersOfflineList.innerHTML = '';
                    Object.keys(window.__usersCache).forEach(function(uid) {
                        if (window.__onlineUsers.has(uid) || String(uid) === String(ME)) return;
                        const d = window.__usersCache[uid];
                        const li = document.createElement('li');
                        li.className = 'l69-users-panel__item';
                        li.innerHTML =
                            '<div class="l69-users-panel__initials">' + (d.name||'?').charAt(0).toUpperCase() + '</div>' +
                            '<span class="l69-users-panel__name">' + escHtml(d.name) + '</span>' +
                            '<span class="l69-users-panel__dot l69-users-panel__dot--offline"></span>';
                        usersOfflineList.appendChild(li);
                    });
                }
            }

