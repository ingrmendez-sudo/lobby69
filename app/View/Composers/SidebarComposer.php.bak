<?php
namespace App\View\Composers;

use Illuminate\View\View;
use Illuminate\Support\Facades\Auth;
use Illuminate\Support\Facades\DB;

class SidebarComposer
{
    public function compose(View $view): void
    {
        if (!Auth::check()) return;

        $userId = (string) Auth::id();

        $whoViewedMe      = collect();
        $whoViewedMeCount = 0;
        $iViewed          = collect();
        $iViewedCount     = 0;

        try {
            // ── Quién me vio ──────────────────────────────────────────
            $whoViewedMeCount = DB::table('profile_views')
                ->whereRaw('viewed_id::text = ?', [$userId])
                ->distinct()
                ->count('viewer_id');

            $whoViewedMe = DB::table('profile_views as pv')
                ->join('users as u', DB::raw('u.id::text'), '=', DB::raw('pv.viewer_id::text'))
                ->leftJoin('profiles as p', DB::raw('p.user_id::text'), '=', DB::raw('u.id::text'))
                ->whereRaw('pv.viewed_id::text = ?', [$userId])
                ->whereRaw("u.id::text != ?", [$userId])
                ->where('u.role', '!=', 'admin')
                ->orderByDesc('pv.created_at')   // <-- ajusta aquí si la columna es viewed_at
                ->limit(5)
                ->select([
                    DB::raw('u.id::text as uid'),
                    DB::raw('COALESCE(p.nickname, u.username) as nickname'),
                    DB::raw('p.display_name as display_name'),
                    DB::raw('p.avatar_url as avatar_url'),
                    DB::raw('p.verified_profile as verified_profile'),
                    DB::raw('(SELECT id FROM photos ap WHERE ap.user_id::text = u.id::text
                              AND ap.is_profile_photo = true AND ap.status = \'approved\'
                              LIMIT 1) as avatar_photo_id'),
                    'pv.created_at as visited_at',   // ajusta si la columna es viewed_at
                ])
                ->get();

        } catch (\Throwable $e) {
            // Descomenta para depurar: \Log::error('SidebarComposer whoViewedMe: '.$e->getMessage());
        }

        try {
            // ── A quién visité ────────────────────────────────────────
            $iViewedCount = DB::table('profile_views')
                ->whereRaw('viewer_id::text = ?', [$userId])
                ->distinct()
                ->count('viewed_id');

            $iViewed = DB::table('profile_views as pv')
                ->join('users as u', DB::raw('u.id::text'), '=', DB::raw('pv.viewed_id::text'))
                ->leftJoin('profiles as p', DB::raw('p.user_id::text'), '=', DB::raw('u.id::text'))
                ->whereRaw('pv.viewer_id::text = ?', [$userId])
                ->whereRaw("u.id::text != ?", [$userId])
                ->where('u.role', '!=', 'admin')
                ->orderByDesc('pv.created_at')   // <-- ajusta aquí si la columna es viewed_at
                ->limit(5)
                ->select([
                    DB::raw('u.id::text as uid'),
                    DB::raw('COALESCE(p.nickname, u.username) as nickname'),
                    DB::raw('p.display_name as display_name'),
                    DB::raw('p.avatar_url as avatar_url'),
                    DB::raw('p.verified_profile as verified_profile'),
                    DB::raw('(SELECT id FROM photos ap WHERE ap.user_id::text = u.id::text
                              AND ap.is_profile_photo = true AND ap.status = \'approved\'
                              LIMIT 1) as avatar_photo_id'),
                    'pv.created_at as visited_at',   // ajusta si la columna es viewed_at
                ])
                ->get();

        } catch (\Throwable $e) {
            // Descomenta para depurar: \Log::error('SidebarComposer iViewed: '.$e->getMessage());
        }

        $view->with(compact(
            'whoViewedMe', 'whoViewedMeCount',
            'iViewed', 'iViewedCount'
        ));
    }
}
